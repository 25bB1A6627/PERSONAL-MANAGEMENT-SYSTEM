<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Personal Management System</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: Arial, Helvetica, sans-serif; 
}

:root {
    --primary: #4f46e5;
    --primary-dark: #3730a3;
    --secondary: #6366f1;
    --bg: #f5f7fb;
    --white: #ffffff;
    --text: #1f2937;
    --muted: #6b7280;
    --border: #e5e7eb;
    --danger: #dc2626;
    --success: #16a34a;
    --warning: #d97706;
    --sidebar: #111827;
}

body {
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
}

/* =========================
   AUTH
========================= */

.auth-container {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background:
        linear-gradient(135deg, #4f46e5, #7c3aed);
    padding: 20px;
}

.auth-card {
    width: 100%;
    max-width: 430px;
    background: white;
    border-radius: 20px;
    padding: 35px;
    box-shadow: 0 20px 50px rgba(0,0,0,.2);
}

.logo {
    text-align: center;
    margin-bottom: 25px;
}

.logo-icon {
    width: 65px;
    height: 65px;
    background: var(--primary);
    color: white;
    border-radius: 18px;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 30px;
    margin: auto;
}

.logo h1 {
    margin-top: 12px;
    font-size: 25px;
}

.logo p {
    color: var(--muted);
    margin-top: 5px;
}

.form-group {
    margin-bottom: 17px;
}

.form-group label {
    display: block;
    font-size: 14px;
    font-weight: bold;
    margin-bottom: 7px;
}

input,
textarea,
select {
    width: 100%;
    border: 1px solid var(--border);
    border-radius: 9px;
    padding: 12px;
    outline: none;
    font-size: 14px;
    background: white;
}

input:focus,
textarea:focus,
select:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(79,70,229,.1);
}

textarea {
    resize: vertical;
    min-height: 100px;
}

.btn {
    border: none;
    border-radius: 9px;
    padding: 11px 16px;
    cursor: pointer;
    font-weight: bold;
    transition: .2s;
}

.btn:hover {
    transform: translateY(-1px);
}

.btn-primary {
    background: var(--primary);
    color: white;
}

.btn-primary:hover {
    background: var(--primary-dark);
}

.btn-danger {
    background: #fee2e2;
    color: var(--danger);
}

.btn-success {
    background: #dcfce7;
    color: var(--success);
}

.btn-warning {
    background: #fef3c7;
    color: var(--warning);
}

.btn-secondary {
    background: #eef2ff;
    color: var(--primary);
}

.full {
    width: 100%;
}

.auth-switch {
    text-align: center;
    margin-top: 18px;
    color: var(--muted);
    font-size: 14px;
}

.auth-switch span {
    color: var(--primary);
    cursor: pointer;
    font-weight: bold;
}

.error {
    color: var(--danger);
    font-size: 13px;
    margin-bottom: 12px;
}

/* =========================
   APP LAYOUT
========================= */

.app {
    display: none;
    min-height: 100vh;
}

.sidebar {
    position: fixed;
    left: 0;
    top: 0;
    bottom: 0;
    width: 250px;
    background: var(--sidebar);
    color: white;
    padding: 22px 15px;
    z-index: 10;
}

.sidebar-brand {
    padding: 10px;
    margin-bottom: 25px;
}

.sidebar-brand h2 {
    font-size: 19px;
}

.sidebar-brand p {
    color: #9ca3af;
    font-size: 12px;
    margin-top: 5px;
}

.nav-item {
    padding: 13px;
    border-radius: 9px;
    cursor: pointer;
    margin-bottom: 5px;
    color: #d1d5db;
    display: flex;
    align-items: center;
    gap: 12px;
}

.nav-item:hover,
.nav-item.active {
    background: #312e81;
    color: white;
}

.logout {
    position: absolute;
    bottom: 20px;
    left: 15px;
    right: 15px;
}

.main {
    margin-left: 250px;
    min-height: 100vh;
}

.topbar {
    height: 70px;
    background: white;
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 30px;
    position: sticky;
    top: 0;
    z-index: 5;
}

.topbar h3 {
    font-size: 18px;
}

.user-info {
    display: flex;
    align-items: center;
    gap: 10px;
}

.avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--primary);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
}

.content {
    padding: 30px;
}

.page {
    display: none;
}

.page.active {
    display: block;
}

/* =========================
   DASHBOARD
========================= */

.page-title {
    margin-bottom: 25px;
}

.page-title h1 {
    font-size: 27px;
}

.page-title p {
    color: var(--muted);
    margin-top: 5px;
}

.stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    margin-bottom: 25px;
}

.stat-card {
    background: white;
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 20px;
}

.stat-card .icon {
    width: 43px;
    height: 43px;
    background: #eef2ff;
    color: var(--primary);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 13px;
}

.stat-card h2 {
    font-size: 27px;
}

.stat-card p {
    color: var(--muted);
    font-size: 13px;
    margin-top: 3px;
}

.dashboard-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 20px;
}

.card {
    background: white;
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 20px;
    margin-bottom: 20px;
}

.card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 17px;
}

.card-header h3 {
    font-size: 17px;
}

/* =========================
   TASKS
========================= */

.toolbar {
    background: white;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 15px;
    margin-bottom: 20px;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
}

.toolbar input {
    flex: 1;
    min-width: 180px;
}

.toolbar select {
    width: 160px;
}

.task-item,
.note-item,
.event-item {
    border: 1px solid var(--border);
    border-radius: 11px;
    padding: 15px;
    margin-bottom: 10px;
    background: white;
}

.task-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
}

.task-left {
    display: flex;
    align-items: flex-start;
    gap: 12px;
}

.task-check {
    width: 20px;
    height: 20px;
    margin-top: 2px;
}

.task-title {
    font-weight: bold;
}

.task-description {
    font-size: 13px;
    color: var(--muted);
    margin-top: 5px;
}

.task-meta {
    margin-top: 8px;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
}

.badge {
    display: inline-block;
    padding: 4px 9px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: bold;
}

.priority-high {
    background: #fee2e2;
    color: #b91c1c;
}

.priority-medium {
    background: #fef3c7;
    color: #92400e;
}

.priority-low {
    background: #dcfce7;
    color: #166534;
}

.status-pending {
    background: #e0e7ff;
    color: #3730a3;
}

.status-progress {
    background: #dbeafe;
    color: #1d4ed8;
}

.status-completed {
    background: #dcfce7;
    color: #166534;
}

.task-actions {
    display: flex;
    gap: 7px;
}

.task-actions button {
    padding: 7px 10px;
    font-size: 12px;
}

/* =========================
   MODAL
========================= */

.modal {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.55);
    display: none;
    justify-content: center;
    align-items: center;
    z-index: 100;
    padding: 20px;
}

.modal.show {
    display: flex;
}

.modal-box {
    background: white;
    width: 100%;
    max-width: 550px;
    max-height: 90vh;
    overflow-y: auto;
    border-radius: 15px;
    padding: 25px;
}

.modal-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 20px;
}

.close {
    background: none;
    border: none;
    font-size: 25px;
    cursor: pointer;
}

/* =========================
   CALENDAR
========================= */

.calendar-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.calendar-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 5px;
}

.calendar-day-name {
    text-align: center;
    font-weight: bold;
    color: var(--muted);
    padding: 10px;
}

.calendar-day {
    min-height: 100px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: white;
    padding: 8px;
    cursor: pointer;
}

.calendar-day:hover {
    border-color: var(--primary);
}

.calendar-day.today {
    border: 2px solid var(--primary);
}

.calendar-day.empty {
    background: #f9fafb;
}

.day-number {
    font-weight: bold;
}

.calendar-event {
    background: #eef2ff;
    color: var(--primary);
    font-size: 11px;
    padding: 4px;
    border-radius: 5px;
    margin-top: 5px;
    overflow: hidden;
}

/* =========================
   NOTES
========================= */

.notes-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
}

.note-item {
    min-height: 150px;
}

.note-item h3 {
    margin-bottom: 8px;
}

.note-content {
    color: var(--muted);
    font-size: 14px;
    white-space: pre-wrap;
}

.note-date {
    font-size: 11px;
    color: #9ca3af;
    margin-top: 12px;
}

/* =========================
   PROFILE
========================= */

.profile-box {
    max-width: 650px;
}

.profile-avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: var(--primary);
    color: white;
    font-size: 30px;
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 20px;
}

/* =========================
   TOAST
========================= */

.toast {
    position: fixed;
    right: 25px;
    bottom: 25px;
    background: #111827;
    color: white;
    padding: 13px 18px;
    border-radius: 9px;
    display: none;
    z-index: 200;
    box-shadow: 0 10px 30px rgba(0,0,0,.2);
}

.toast.show {
    display: block;
}

/* =========================
   EMPTY STATE
========================= */

.empty {
    text-align: center;
    color: var(--muted);
    padding: 35px;
}

/* =========================
   RESPONSIVE
========================= */

.mobile-menu {
    display: none;
}

@media(max-width: 1000px) {
    .stats {
        grid-template-columns: repeat(2, 1fr);
    }

    .dashboard-grid {
        grid-template-columns: 1fr;
    }

    .notes-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media(max-width: 750px) {
    .sidebar {
        transform: translateX(-100%);
        transition: .3s;
    }

    .sidebar.open {
        transform: translateX(0);
    }

    .main {
        margin-left: 0;
    }

    .mobile-menu {
        display: block;
        border: none;
        background: none;
        font-size: 23px;
        cursor: pointer;
    }

    .content {
        padding: 18px;
    }

    .stats {
        grid-template-columns: 1fr 1fr;
    }

    .notes-grid {
        grid-template-columns: 1fr;
    }

    .task-item {
        flex-direction: column;
        align-items: flex-start;
    }

    .task-actions {
        width: 100%;
    }

    .task-actions button {
        flex: 1;
    }

    .calendar-day {
        min-height: 65px;
        font-size: 11px;
    }

    .calendar-event {
        display: none;
    }
}

@media(max-width: 500px) {
    .stats {
        grid-template-columns: 1fr;
    }

    .auth-card {
        padding: 25px;
    }

    .calendar-day {
        min-height: 50px;
    }

    .topbar {
        padding: 0 15px;
    }
}
</style>
</head>

<body>

<!-- =========================
     AUTHENTICATION
========================= -->

<div id="authContainer" class="auth-container">

    <div class="auth-card">

        <div class="logo">
            <div class="logo-icon">✓</div>
            <h1>Personal Manager</h1>
            <p>Organize your life in one place</p>
        </div>

        <!-- LOGIN -->
        <div id="loginForm">

            <h2 style="margin-bottom:20px;">Welcome Back</h2>

            <div id="loginError" class="error"></div>

            <div class="form-group">
                <label>Email</label>
                <input id="loginEmail" type="email" placeholder="Enter your email">
            </div>

            <div class="form-group">
                <label>Password</label>
                <input id="loginPassword" type="password" placeholder="Enter your password">
            </div>

            <button class="btn btn-primary full" onclick="login()">
                Login
            </button>

            <div class="auth-switch">
                Don't have an account?
                <span onclick="showRegister()">Create Account</span>
            </div>

        </div>

        <!-- REGISTER -->
        <div id="registerForm" style="display:none;">

            <h2 style="margin-bottom:20px;">Create Account</h2>

            <div id="registerError" class="error"></div>

            <div class="form-group">
                <label>Full Name</label>
                <input id="registerName" type="text" placeholder="Your name">
            </div>

            <div class="form-group">
                <label>Email</label>
                <input id="registerEmail" type="email" placeholder="Your email">
            </div>

            <div class="form-group">
                <label>Password</label>
                <input id="registerPassword" type="password" placeholder="Create password">
            </div>

            <button class="btn btn-primary full" onclick="register()">
                Register
            </button>

            <div class="auth-switch">
                Already have an account?
                <span onclick="showLogin()">Login</span>
            </div>

        </div>

    </div>

</div>


<!-- =========================
     APPLICATION
========================= -->

<div id="app" class="app">

    <!-- SIDEBAR -->

    <aside id="sidebar" class="sidebar">

        <div class="sidebar-brand">
            <h2>✓ Personal Manager</h2>
            <p>Personal Management System</p>
        </div>

        <div class="nav-item active" onclick="showPage('dashboard', this)">
            📊 Dashboard
        </div>

        <div class="nav-item" onclick="showPage('tasks', this)">
            ✅ Tasks
        </div>

        <div class="nav-item" onclick="showPage('calendar', this)">
            📅 Calendar
        </div>

        <div class="nav-item" onclick="showPage('notes', this)">
            📝 Notes
        </div>

        <div class="nav-item" onclick="showPage('reminders', this)">
            🔔 Reminders
        </div>

        <div class="nav-item" onclick="showPage('profile', this)">
            👤 Profile
        </div>

        <div class="nav-item logout" onclick="logout()">
            🚪 Logout
        </div>

    </aside>


    <!-- MAIN -->

    <main class="main">

        <header class="topbar">

            <div style="display:flex;align-items:center;gap:15px;">
                <button class="mobile-menu" onclick="toggleSidebar()">☰</button>
                <h3 id="topTitle">Dashboard</h3>
            </div>

            <div class="user-info">
                <span id="topUserName">User</span>
                <div class="avatar" id="topAvatar">U</div>
            </div>

        </header>


        <section class="content">


            <!-- =========================
                 DASHBOARD
            ========================= -->

            <div id="dashboard" class="page active">

                <div class="page-title">
                    <h1 id="welcomeMessage">Good Afternoon!</h1>
                    <p>Here's what's happening with your activities.</p>
                </div>

                <div class="stats">

                    <div class="stat-card">
                        <div class="icon">📋</div>
                        <h2 id="totalTasks">0</h2>
                        <p>Total Tasks</p>
                    </div>

                    <div class="stat-card">
                        <div class="icon">⏳</div>
                        <h2 id="pendingTasks">0</h2>
                        <p>Pending Tasks</p>
                    </div>

                    <div class="stat-card">
                        <div class="icon">✓</div>
                        <h2 id="completedTasks">0</h2>
                        <p>Completed Tasks</p>
                    </div>

                    <div class="stat-card">
                        <div class="icon">⚠</div>
                        <h2 id="overdueTasks">0</h2>
                        <p>Overdue Tasks</p>
                    </div>

                </div>


                <div class="dashboard-grid">

                    <div class="card">

                        <div class="card-header">
                            <h3>Upcoming Tasks</h3>
                            <button class="btn btn-secondary"
                                    onclick="showPageById('tasks')">
                                View All
                            </button>
                        </div>

                        <div id="dashboardTasks"></div>

                    </div>


                    <div>

                        <div class="card">

                            <div class="card-header">
                                <h3>Quick Actions</h3>
                            </div>

                            <button class="btn btn-primary full"
                                    onclick="openTaskModal()">
                                + Add Task
                            </button>

                            <br><br>

                            <button class="btn btn-secondary full"
                                    onclick="openNoteModal()">
                                + Create Note
                            </button>

                            <br><br>

                            <button class="btn btn-warning full"
                                    onclick="openEventModal()">
                                + Add Event
                            </button>

                        </div>


                        <div class="card">

                            <div class="card-header">
                                <h3>Recent Notes</h3>
                            </div>

                            <div id="recentNotes"></div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- =========================
                 TASKS
            ========================= -->

            <div id="tasks" class="page">

                <div class="page-title">

                    <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;">
                        <div>
                            <h1>Task Management</h1>
                            <p>Create, organize and track your tasks.</p>
                        </div>

                        <button class="btn btn-primary"
                                onclick="openTaskModal()">
                            + Add Task
                        </button>
                    </div>

                </div>


                <div class="toolbar">

                    <input id="taskSearch"
                           placeholder="Search tasks..."
                           oninput="renderTasks()">

                    <select id="taskFilter"
                            onchange="renderTasks()">

                        <option value="all">All Status</option>
                        <option value="pending">Pending</option>
                        <option value="progress">In Progress</option>
                        <option value="completed">Completed</option>

                    </select>

                    <select id="priorityFilter"
                            onchange="renderTasks()">

                        <option value="all">All Priority</option>
                        <option value="high">High</option>
                        <option value="medium">Medium</option>
                        <option value="low">Low</option>

                    </select>

                </div>


                <div id="taskList"></div>

            </div>


            <!-- =========================
                 CALENDAR
            ========================== -->

            <div id="calendar" class="page">

                <div class="page-title">

                    <div class="calendar-header">

                        <div>
                            <h1>Calendar</h1>
                            <p>View your scheduled events.</p>
                        </div>

                        <button class="btn btn-primary"
                                onclick="openEventModal()">
                            + Add Event
                        </button>

                    </div>

                </div>


                <div class="card">

                    <div class="calendar-header">

                        <button class="btn btn-secondary"
                                onclick="previousMonth()">
                            ← Previous
                        </button>

                        <h2 id="calendarTitle"></h2>

                        <button class="btn btn-secondary"
                                onclick="nextMonth()">
                            Next →
                        </button>

                    </div>

                    <div id="calendarGrid"
                         class="calendar-grid">
                    </div>

                </div>

                <div class="card">

                    <div class="card-header">
                        <h3>Upcoming Events</h3>
                    </div>

                    <div id="eventList"></div>

                </div>

            </div>


            <!-- =========================
                 NOTES
            ========================== -->

            <div id="notes" class="page">

                <div class="page-title">

                    <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;">

                        <div>
                            <h1>Notes</h1>
                            <p>Create and organize your personal notes.</p>
                        </div>

                        <button class="btn btn-primary"
                                onclick="openNoteModal()">
                            + New Note
                        </button>

                    </div>

                </div>


                <div class="toolbar">

                    <input id="noteSearch"
                           placeholder="Search notes..."
                           oninput="renderNotes()">

                </div>


                <div id="notesGrid"
                     class="notes-grid">
                </div>

            </div>


            <!-- =========================
                 REMINDERS
            ========================== -->

            <div id="reminders" class="page">

                <div class="page-title">
                    <h1>Reminders</h1>
                    <p>Manage your upcoming reminders.</p>
                </div>

                <div class="card">

                    <div class="card-header">
                        <h3>Task Reminders</h3>
                    </div>

                    <div id="reminderList"></div>

                </div>

            </div>


            <!-- =========================
                 PROFILE
            ========================== -->

            <div id="profile" class="page">

                <div class="page-title">
                    <h1>Profile</h1>
                    <p>Manage your personal information.</p>
                </div>


                <div class="card profile-box">

                    <div class="profile-avatar"
                         id="profileAvatar">
                        U
                    </div>

                    <div class="form-group">
                        <label>Full Name</label>
                        <input id="profileName">
                    </div>

                    <div class="form-group">
                        <label>Email</label>
                        <input id="profileEmail"
                               type="email"
                               disabled>
                    </div>

                    <button class="btn btn-primary"
                            onclick="updateProfile()">
                        Save Changes
                    </button>

                </div>

            </div>


        </section>

    </main>

</div>


<!-- =========================
     TASK MODAL
========================= -->

<div id="taskModal" class="modal">

    <div class="modal-box">

        <div class="modal-header">

            <h2 id="taskModalTitle">Add Task</h2>

            <button class="close"
                    onclick="closeModal('taskModal')">
                ×
            </button>

        </div>

        <input type="hidden" id="editTaskId">

        <div class="form-group">
            <label>Task Title *</label>
            <input id="taskTitle"
                   placeholder="Enter task title">
        </div>

        <div class="form-group">
            <label>Description</label>
            <textarea id="taskDescription"
                      placeholder="Task description"></textarea>
        </div>

        <div class="form-group">
            <label>Priority</label>

            <select id="taskPriority">

                <option value="low">Low</option>
                <option value="medium" selected>Medium</option>
                <option value="high">High</option>

            </select>

        </div>

        <div class="form-group">
            <label>Status</label>

            <select id="taskStatus">

                <option value="pending">Pending</option>
                <option value="progress">In Progress</option>
                <option value="completed">Completed</option>

            </select>

        </div>

        <div class="form-group">
            <label>Deadline</label>
            <input id="taskDueDate" type="datetime-local">
        </div>

        <div style="display:flex;gap:10px;justify-content:flex-end;">

            <button class="btn btn-secondary"
                    onclick="closeModal('taskModal')">
                Cancel
            </button>

            <button class="btn btn-primary"
                    onclick="saveTask()">
                Save Task
            </button>

        </div>

    </div>

</div>


<!-- =========================
     NOTE MODAL
========================= -->

<div id="noteModal" class="modal">

    <div class="modal-box">

        <div class="modal-header">

            <h2>New Note</h2>

            <button class="close"
                    onclick="closeModal('noteModal')">
                ×
            </button>

        </div>

        <input type="hidden" id="editNoteId">

        <div class="form-group">

            <label>Title *</label>

            <input id="noteTitle"
                   placeholder="Note title">

        </div>

        <div class="form-group">

            <label>Content *</label>

            <textarea id="noteContent"
                      placeholder="Write your note..."></textarea>

        </div>

        <div style="display:flex;gap:10px;justify-content:flex-end;">

            <button class="btn btn-secondary"
                    onclick="closeModal('noteModal')">
                Cancel
            </button>

            <button class="btn btn-primary"
                    onclick="saveNote()">
                Save Note
            </button>

        </div>

    </div>

</div>


<!-- =========================
     EVENT MODAL
========================= -->

<div id="eventModal" class="modal">

    <div class="modal-box">

        <div class="modal-header">

            <h2>Add Calendar Event</h2>

            <button class="close"
                    onclick="closeModal('eventModal')">
                ×
            </button>

        </div>

        <div class="form-group">
            <label>Event Title *</label>
            <input id="eventTitle"
                   placeholder="Event title">
        </div>

        <div class="form-group">
            <label>Date *</label>
            <input id="eventDate"
                   type="date">
        </div>

        <div class="form-group">
            <label>Time</label>
            <input id="eventTime"
                   type="time">
        </div>

        <div class="form-group">
            <label>Description</label>
            <textarea id="eventDescription"
                      placeholder="Event description"></textarea>
        </div>

        <div style="display:flex;gap:10px;justify-content:flex-end;">

            <button class="btn btn-secondary"
                    onclick="closeModal('eventModal')">
                Cancel
            </button>

            <button class="btn btn-primary"
                    onclick="saveEvent()">
                Save Event
            </button>

        </div>

    </div>

</div>


<!-- TOAST -->

<div id="toast" class="toast"></div>


<script>

/* =========================================================
   PERSONAL MANAGEMENT SYSTEM
   LocalStorage Based Academic Project
========================================================= */


/* =========================
   GLOBAL DATA
========================= */

let currentUser = null;

let currentCalendarDate = new Date();

let users = JSON.parse(localStorage.getItem("pms_users") || "[]");
let tasks = JSON.parse(localStorage.getItem("pms_tasks") || "[]");
let notes = JSON.parse(localStorage.getItem("pms_notes") || "[]");
let events = JSON.parse(localStorage.getItem("pms_events") || "[]");


/* =========================
   UTILITY FUNCTIONS
========================= */

function saveData() {

    localStorage.setItem("pms_users", JSON.stringify(users));
    localStorage.setItem("pms_tasks", JSON.stringify(tasks));
    localStorage.setItem("pms_notes", JSON.stringify(notes));
    localStorage.setItem("pms_events", JSON.stringify(events));

}


function generateId(prefix) {

    return prefix + Date.now() + Math.random()
        .toString(36)
        .substring(2, 7);

}


function showToast(message) {

    const toast = document.getElementById("toast");

    toast.textContent = message;
    toast.classList.add("show");

    setTimeout(() => {
        toast.classList.remove("show");
    }, 2500);

}


function formatDate(dateString) {

    if (!dateString) return "No deadline";

    const date = new Date(dateString);

    return date.toLocaleString([], {
        year: "numeric",
        month: "short",
        day: "numeric",
        hour: "2-digit",
        minute: "2-digit"
    });

}


function todayDate() {

    return new Date().toISOString().split("T")[0];

}


function isOverdue(task) {

    if (!task.dueDate || task.status === "completed") {
        return false;
    }

    return new Date(task.dueDate) < new Date();

}


function userTasks() {

    return tasks.filter(t => t.userId === currentUser.id);

}


function userNotes() {

    return notes.filter(n => n.userId === currentUser.id);

}


function userEvents() {

    return events.filter(e => e.userId === currentUser.id);

}


/* =========================
   AUTHENTICATION
========================= */

function showRegister() {

    document.getElementById("loginForm").style.display = "none";
    document.getElementById("registerForm").style.display = "block";

}


function showLogin() {

    document.getElementById("registerForm").style.display = "none";
    document.getElementById("loginForm").style.display = "block";

}


function register() {

    const name =
        document.getElementById("registerName").value.trim();

    const email =
        document.getElementById("registerEmail").value.trim()
            .toLowerCase();

    const password =
        document.getElementById("registerPassword").value;

    const error =
        document.getElementById("registerError");

    error.textContent = "";

    if (!name || !email || !password) {

        error.textContent =
            "Please fill in all required fields.";

        return;
    }

    if (password.length < 4) {

        error.textContent =
            "Password must contain at least 4 characters.";

        return;
    }

    if (users.some(u => u.email === email)) {

        error.textContent =
            "An account with this email already exists.";

        return;
    }

    const user = {

        id: generateId("user_"),
        name,
        email,
        password,
        preferences: {}

    };

    users.push(user);

    saveData();

    showToast("Account created successfully.");

    showLogin();

    document.getElementById("loginEmail").value = email;

}


function login() {

    const email =
        document.getElementById("loginEmail").value.trim()
            .toLowerCase();

    const password =
        document.getElementById("loginPassword").value;

    const error =
        document.getElementById("loginError");

    error.textContent = "";

    const user = users.find(
        u => u.email === email &&
             u.password === password
    );

    if (!user) {

        error.textContent =
            "Invalid email or password.";

        return;
    }

    currentUser = user;

    sessionStorage.setItem(
        "pms_current_user",
        user.id
    );

    startApplication();

}


function logout() {

    sessionStorage.removeItem("pms_current_user");

    currentUser = null;

    document.getElementById("app").style.display = "none";
    document.getElementById("authContainer").style.display = "flex";

    showLogin();

}


/* =========================
   START APP
========================= */

function startApplication() {

    document.getElementById("authContainer").style.display = "none";
    document.getElementById("app").style.display = "block";

    updateUserUI();

    renderDashboard();
    renderTasks();
    renderNotes();
    renderCalendar();
    renderEvents();
    renderReminders();
    loadProfile();

}


function checkSession() {

    const userId =
        sessionStorage.getItem("pms_current_user");

    if (!userId) return;

    const user =
        users.find(u => u.id === userId);

    if (user) {

        currentUser = user;

        startApplication();

    }

}


/* =========================
   USER INTERFACE
========================= */

function updateUserUI() {

    const name = currentUser.name || "User";

    document.getElementById("topUserName").textContent = name;

    document.getElementById("topAvatar").textContent =
        name.charAt(0).toUpperCase();

    document.getElementById("profileAvatar").textContent =
        name.charAt(0).toUpperCase();

    const hour = new Date().getHours();

    let greeting = "Good Evening";

    if (hour < 12) {
        greeting = "Good Morning";
    } else if (hour < 18) {
        greeting = "Good Afternoon";
    }

    document.getElementById("welcomeMessage").textContent =
        greeting + ", " + name + "!";

}


function showPage(pageId, element) {

    document.querySelectorAll(".page")
        .forEach(page => page.classList.remove("active"));

    document.getElementById(pageId)
        .classList.add("active");

    document.querySelectorAll(".nav-item")
        .forEach(item => item.classList.remove("active"));

    if (element) {
        element.classList.add("active");
    }

    const titles = {

        dashboard: "Dashboard",
        tasks: "Task Management",
        calendar: "Calendar",
        notes: "Notes",
        reminders: "Reminders",
        profile: "Profile"

    };

    document.getElementById("topTitle").textContent =
        titles[pageId] || "Personal Manager";

    document.getElementById("sidebar")
        .classList.remove("open");

}


function showPageById(pageId) {

    const navItems =
        document.querySelectorAll(".nav-item");

    let found = false;

    navItems.forEach(item => {

        if (item.getAttribute("onclick") &&
            item.getAttribute("onclick").includes(
                "'" + pageId + "'"
            )) {

            showPage(pageId, item);
            found = true;

        }

    });

    if (!found) {

        showPage(pageId);

    }

}


function toggleSidebar() {

    document.getElementById("sidebar")
        .classList.toggle("open");

}


/* =========================
   DASHBOARD
========================= */

function renderDashboard() {

    if (!currentUser) return;

    const list = userTasks();

    const total = list.length;

    const pending =
        list.filter(t => t.status === "pending").length;

    const completed =
        list.filter(t => t.status === "completed").length;

    const overdue =
        list.filter(isOverdue).length;

    document.getElementById("totalTasks").textContent = total;
    document.getElementById("pendingTasks").textContent = pending;
    document.getElementById("completedTasks").textContent = completed;
    document.getElementById("overdueTasks").textContent = overdue;


    let upcoming =
        list
        .filter(t => t.status !== "completed")
        .sort((a,b) => {

            if (!a.dueDate) return 1;
            if (!b.dueDate) return -1;

            return new Date(a.dueDate) -
                   new Date(b.dueDate);

        })
        .slice(0,5);


    const dashboard =
        document.getElementById("dashboardTasks");

    if (upcoming.length === 0) {

        dashboard.innerHTML =
            `<div class="empty">No upcoming tasks.</div>`;

    } else {

        dashboard.innerHTML =
            upcoming.map(taskHTML).join("");

    }


    const recent =
        userNotes()
        .sort((a,b) =>
            new Date(b.updatedDate) -
            new Date(a.updatedDate)
        )
        .slice(0,3);

    const recentNotes =
        document.getElementById("recentNotes");

    if (recent.length === 0) {

        recentNotes.innerHTML =
            `<div class="empty">No notes yet.</div>`;

    } else {

        recentNotes.innerHTML =
            recent.map(note => `
                <div class="note-item">
                    <h3>${escapeHTML(note.title)}</h3>
                    <div class="note-content">
                        ${escapeHTML(note.content.substring(0,100))}
                    </div>
                </div>
            `).join("");

    }

}


/* =========================
   TASK MANAGEMENT
========================= */

function openTaskModal(taskId = null) {

    document.getElementById("taskModal")
        .classList.add("show");

    if (taskId) {

        const task =
            tasks.find(t => t.id === taskId);

        if (!task) return;

        document.getElementById("taskModalTitle")
            .textContent = "Edit Task";

        document.getElementById("editTaskId").value =
            task.id;

        document.getElementById("taskTitle").value =
            task.title;

        document.getElementById("taskDescription").value =
            task.description;

        document.getElementById("taskPriority").value =
            task.priority;

        document.getElementById("taskStatus").value =
            task.status;

        document.getElementById("taskDueDate").value =
            task.dueDate || "";

    } else {

        document.getElementById("taskModalTitle")
            .textContent = "Add Task";

        document.getElementById("editTaskId").value = "";

        document.getElementById("taskTitle").value = "";

        document.getElementById("taskDescription").value = "";

        document.getElementById("taskPriority").value = "medium";

        document.getElementById("taskStatus").value = "pending";

        document.getElementById("taskDueDate").value = "";

    }

}


function saveTask() {

    const title =
        document.getElementById("taskTitle").value.trim();

    const description =
        document.getElementById("taskDescription").value.trim();

    const priority =
        document.getElementById("taskPriority").value;

    const status =
        document.getElementById("taskStatus").value;

    const dueDate =
        document.getElementById("taskDueDate").value;

    const editId =
        document.getElementById("editTaskId").value;


    if (!title) {

        showToast("Task title is required.");

        return;
    }


    if (editId) {

        const task =
            tasks.find(t => t.id === editId);

        if (task) {

            task.title = title;
            task.description = description;
            task.priority = priority;
            task.status = status;
            task.dueDate = dueDate;

        }

        showToast("Task updated successfully.");

    } else {

        tasks.push({

            id: generateId("task_"),

            userId: currentUser.id,

            title,

            description,

            priority,

            status,

            dueDate,

            createdDate: new Date().toISOString()

        });

        showToast("Task created successfully.");

    }


    saveData();

    closeModal("taskModal");

    renderTasks();
    renderDashboard();
    renderReminders();

}


function taskHTML(task) {

    const statusNames = {

        pending: "Pending",
        progress: "In Progress",
        completed: "Completed"

    };

    return `

        <div class="task-item">

            <div class="task-left">

                <input
                    class="task-check"
                    type="checkbox"
                    ${task.status === "completed" ? "checked" : ""}
                    onchange="toggleTask('${task.id}')"
                >

                <div>

                    <div class="task-title">
                        ${escapeHTML(task.title)}
                    </div>

                    <div class="task-description">
                        ${escapeHTML(task.description || "")}
                    </div>

                    <div class="task-meta">

                        <span class="badge priority-${task.priority}">
                            ${task.priority.toUpperCase()}
                        </span>

                        <span class="badge status-${task.status}">
                            ${statusNames[task.status]}
                        </span>

                        ${
                            task.dueDate
                            ?
                            `<span class="badge ${isOverdue(task) ? "priority-high" : "status-pending"}">
                                ${isOverdue(task) ? "OVERDUE" : "Due"}:
                                ${formatDate(task.dueDate)}
                            </span>`
                            :
                            ""
                        }

                    </div>

                </div>

            </div>


            <div class="task-actions">

                <button
                    class="btn btn-secondary"
                    onclick="openTaskModal('${task.id}')">
                    Edit
                </button>

                <button
                    class="btn btn-danger"
                    onclick="deleteTask('${task.id}')">
                    Delete
                </button>

            </div>

        </div>

    `;

}


function renderTasks() {

    if (!currentUser) return;

    const search =
        document.getElementById("taskSearch").value
            .toLowerCase();

    const statusFilter =
        document.getElementById("taskFilter").value;

    const priorityFilter =
        document.getElementById("priorityFilter").value;


    let list = userTasks();


    if (search) {

        list = list.filter(task =>
            task.title.toLowerCase().includes(search) ||
            task.description.toLowerCase().includes(search)
        );

    }


    if (statusFilter !== "all") {

        list = list.filter(
            task => task.status === statusFilter
        );

    }


    if (priorityFilter !== "all") {

        list = list.filter(
            task => task.priority === priorityFilter
        );

    }


    list.sort((a,b) => {

        if (!a.dueDate) return 1;
        if (!b.dueDate) return -1;

        return new Date(a.dueDate) -
               new Date(b.dueDate);

    });


    const container =
        document.getElementById("taskList");


    if (list.length === 0) {

        container.innerHTML =
            `<div class="card empty">
                No tasks found.
            </div>`;

        return;

    }


    container.innerHTML =
        list.map(taskHTML).join("");

}


function toggleTask(id) {

    const task =
        tasks.find(t => t.id === id);

    if (!task) return;

    task.status =
        task.status === "completed"
        ? "pending"
        : "completed";

    saveData();

    renderTasks();
    renderDashboard();
    renderReminders();

    showToast(
        task.status === "completed"
        ? "Task completed!"
        : "Task moved to pending."
    );

}


function deleteTask(id) {

    if (!confirm("Delete this task?")) return;

    tasks =
        tasks.filter(task => task.id !== id);

    saveData();

    renderTasks();
    renderDashboard();
    renderReminders();

    showToast("Task deleted.");

}


/* =========================
   NOTES
========================= */

function openNoteModal(noteId = null) {

    document.getElementById("noteModal")
        .classList.add("show");

    if (noteId) {

        const note =
            notes.find(n => n.id === noteId);

        document.getElementById("editNoteId").value =
            note.id;

        document.getElementById("noteTitle").value =
            note.title;

        document.getElementById("noteContent").value =
            note.content;

    } else {

        document.getElementById("editNoteId").value = "";

        document.getElementById("noteTitle").value = "";

        document.getElementById("noteContent").value = "";

    }

}


function saveNote() {

    const title =
        document.getElementById("noteTitle")
            .value.trim();

    const content =
        document.getElementById("noteContent")
            .value.trim();

    const editId =
        document.getElementById("editNoteId").value;


    if (!title || !content) {

        showToast("Title and content are required.");

        return;

    }


    if (editId) {

        const note =
            notes.find(n => n.id === editId);

        note.title = title;
        note.content = content;
        note.updatedDate =
            new Date().toISOString();

        showToast("Note updated.");

    } else {

        notes.push({

            id: generateId("note_"),

            userId: currentUser.id,

            title,

            content,

            createdDate:
                new Date().toISOString(),

            updatedDate:
                new Date().toISOString()

        });

        showToast("Note created.");

    }


    saveData();

    closeModal("noteModal");

    renderNotes();
    renderDashboard();

}


function renderNotes() {

    if (!currentUser) return;

    const search =
        document.getElementById("noteSearch")
            .value.toLowerCase();


    let list =
        userNotes().filter(note => {

            return !search ||
                note.title.toLowerCase().includes(search) ||
                note.content.toLowerCase().includes(search);

        });


    list.sort((a,b) =>
        new Date(b.updatedDate) -
        new Date(a.updatedDate)
    );


    const container =
        document.getElementById("notesGrid");


    if (list.length === 0) {

        container.innerHTML =
            `<div class="card empty"
                  style="grid-column:1/-1;">
                No notes found.
            </div>`;

        return;

    }


    container.innerHTML =
        list.map(note => `

            <div class="note-item">

                <div style="
                    display:flex;
                    justify-content:space-between;
                    gap:10px;
                ">

                    <h3>
                        ${escapeHTML(note.title)}
                    </h3>

                    <div>

                        <button
                            class="btn btn-secondary"
                            onclick="openNoteModal('${note.id}')">
                            Edit
                        </button>

                        <button
                            class="btn btn-danger"
                            onclick="deleteNote('${note.id}')">
                            Delete
                        </button>

                    </div>

                </div>

                <div class="note-content">
                    ${escapeHTML(note.content)}
                </div>

                <div class="note-date">
                    Updated:
                    ${formatDate(note.updatedDate)}
                </div>

            </div>

        `).join("");

}


function deleteNote(id) {

    if (!confirm("Delete this note?")) return;

    notes =
        notes.filter(note => note.id !== id);

    saveData();

    renderNotes();
    renderDashboard();

    showToast("Note deleted.");

}


/* =========================
   CALENDAR EVENTS
========================= */

function openEventModal() {

    document.getElementById("eventModal")
        .classList.add("show");

    document.getElementById("eventTitle").value = "";

    document.getElementById("eventDate").value =
        todayDate();

    document.getElementById("eventTime").value = "";

    document.getElementById("eventDescription").value = "";

}


function saveEvent() {

    const title =
        document.getElementById("eventTitle")
            .value.trim();

    const date =
        document.getElementById("eventDate").value;

    const time =
        document.getElementById("eventTime").value;

    const description =
        document.getElementById("eventDescription")
            .value.trim();


    if (!title || !date) {

        showToast("Event title and date are required.");

        return;

    }


    events.push({

        id: generateId("event_"),

        userId: currentUser.id,

        title,

        date,

        time,

        description

    });


    saveData();

    closeModal("eventModal");

    renderCalendar();
    renderEvents();

    showToast("Event added.");

}


function renderEvents() {

    const list =
        userEvents()
        .sort((a,b) => {

            const da =
                new Date(a.date + "T" + (a.time || "00:00"));

            const db =
                new Date(b.date + "T" + (b.time || "00:00"));

            return da - db;

        });


    const container =
        document.getElementById("eventList");


    if (list.length === 0) {

        container.innerHTML =
            `<div class="empty">
                No events scheduled.
            </div>`;

        return;

    }


    container.innerHTML =
        list.map(event => `

            <div class="event-item">

                <div style="
                    display:flex;
                    justify-content:space-between;
                    align-items:center;
                    gap:10px;
                ">

                    <div>

                        <h3>
                            ${escapeHTML(event.title)}
                        </h3>

                        <p style="
                            color:var(--muted);
                            margin-top:5px;
                        ">

                            📅 ${event.date}

                            ${event.time
                                ? " • " + event.time
                                : ""}

                        </p>

                        ${
                            event.description
                            ?
                            `<p style="
                                margin-top:8px;
                                color:var(--muted);
                            ">
                                ${escapeHTML(event.description)}
                            </p>`
                            :
                            ""
                        }

                    </div>

                    <button
                        class="btn btn-danger"
                        onclick="deleteEvent('${event.id}')">
                        Delete
                    </button>

                </div>

            </div>

        `).join("");

}


function deleteEvent(id) {

    if (!confirm("Delete this event?")) return;

    events =
        events.filter(event => event.id !== id);

    saveData();

    renderCalendar();
    renderEvents();

    showToast("Event deleted.");

}


/* =========================
   CALENDAR
========================= */

function renderCalendar() {

    const year =
        currentCalendarDate.getFullYear();

    const month =
        currentCalendarDate.getMonth();


    const monthName =
        currentCalendarDate.toLocaleString(
            "default",
            {month:"long"}
        );


    document.getElementById("calendarTitle")
        .textContent =
        monthName + " " + year;


    const grid =
        document.getElementById("calendarGrid");


    const dayNames =
        ["Sun","Mon","Tue","Wed","Thu","Fri","Sat"];


    let html =
        dayNames.map(day =>
            `<div class="calendar-day-name">
                ${day}
            </div>`
        ).join("");


    const firstDay =
        new Date(year, month, 1).getDay();

    const daysInMonth =
        new Date(year, month + 1, 0).getDate();


    for (let i = 0; i < firstDay; i++) {

        html +=
            `<div class="calendar-day empty"></div>`;

    }


    const monthEvents =
        userEvents();


    for (let day = 1; day <= daysInMonth; day++) {

        const date =
            year + "-" +
            String(month + 1).padStart(2,"0") +
            "-" +
            String(day).padStart(2,"0");


        const isToday =
            date === todayDate();


        const dayEvents =
            monthEvents.filter(
                event => event.date === date
            );


        html += `

            <div class="calendar-day ${isToday ? "today" : ""}"
                 onclick="calendarDayClick('${date}')">

                <div class="day-number">
                    ${day}
                </div>

                ${dayEvents.slice(0,3).map(event => `

                    <div class="calendar-event">
                        ${escapeHTML(event.title)}
                    </div>

                `).join("")}

            </div>

        `;

    }


    grid.innerHTML = html;

}


function previousMonth() {

    currentCalendarDate.setMonth(
        currentCalendarDate.getMonth() - 1
    );

    renderCalendar();

}


function nextMonth() {

    currentCalendarDate.setMonth(
        currentCalendarDate.getMonth() + 1
    );

    renderCalendar();

}


function calendarDayClick(date) {

    document.getElementById("eventModal")
        .classList.add("show");

    document.getElementById("eventDate").value =
        date;

    document.getElementById("eventTitle").value = "";

    document.getElementById("eventTime").value = "";

    document.getElementById("eventDescription").value = "";

}


/* =========================
   REMINDERS
========================= */

function renderReminders() {

    if (!currentUser) return;

    const list =
        userTasks()
        .filter(task =>
            task.dueDate &&
            task.status !== "completed"
        )
        .sort((a,b) =>
            new Date(a.dueDate) -
            new Date(b.dueDate)
        );


    const container =
        document.getElementById("reminderList");


    if (list.length === 0) {

        container.innerHTML =
            `<div class="empty">
                No active reminders.
            </div>`;

        return;

    }


    container.innerHTML =
        list.map(task => `

            <div class="event-item">

                <div style="
                    display:flex;
                    justify-content:space-between;
                    align-items:center;
                    gap:10px;
                ">

                    <div>

                        <h3>
                            ${escapeHTML(task.title)}
                        </h3>

                        <p style="
                            color:var(--muted);
                            margin-top:6px;
                        ">

                            ${
                                isOverdue(task)
                                ? "⚠ OVERDUE"
                                : "🔔 Reminder"
                            }

                            • ${formatDate(task.dueDate)}

                        </p>

                    </div>

                    <button
                        class="btn btn-success"
                        onclick="toggleTask('${task.id}')">
                        Complete
                    </button>

                </div>

            </div>

        `).join("");

}


/* =========================
   PROFILE
========================= */

function loadProfile() {

    document.getElementById("profileName").value =
        currentUser.name;

    document.getElementById("profileEmail").value =
        currentUser.email;

}


function updateProfile() {

    const name =
        document.getElementById("profileName")
            .value.trim();


    if (!name) {

        showToast("Name cannot be empty.");

        return;

    }


    currentUser.name = name;


    const index =
        users.findIndex(
            u => u.id === currentUser.id
        );


    if (index !== -1) {

        users[index] = currentUser;

    }


    saveData();

    updateUserUI();

    showToast("Profile updated successfully.");

}


/* =========================
   MODAL
========================= */

function closeModal(id) {

    document.getElementById(id)
        .classList.remove("show");

}


document.querySelectorAll(".modal")
    .forEach(modal => {

        modal.addEventListener("click", function(e) {

            if (e.target === modal) {

                modal.classList.remove("show");

            }

        });

    });


/* =========================
   SECURITY / HTML ESCAPING
========================= */

function escapeHTML(value) {

    if (value === undefined || value === null) {
        return "";
    }

    return String(value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");

}


/* =========================
   KEYBOARD SHORTCUT
========================= */

document.addEventListener("keydown", function(e) {

    if (e.key === "Escape") {

        document.querySelectorAll(".modal")
            .forEach(modal =>
                modal.classList.remove("show")
            );

    }

});


/* =========================
   INITIALIZE
========================= */

checkSession();

</script>

